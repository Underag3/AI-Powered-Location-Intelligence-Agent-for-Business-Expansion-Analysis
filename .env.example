# API key Google AI Studio (gratis) — sumber model Gemini
GOOGLE_API_KEY=
# Proyek Google Cloud yang dipakai BigQuery (mode Sandbox)
GOOGLE_CLOUD_PROJECT=mcp1234567
# Model Gemini di AI Studio
MODEL_NAME=gemini-3.8-flash
# Peluncur server OpenStreetMap MCP: "uvx" (bawaan) atau "osm-mcp-server"
OSM_MCP_COMMAND=uvx
